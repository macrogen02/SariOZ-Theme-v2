{% paginate collection.products by 24 %}
  <section class="section container" aria-labelledby="CollectionTitle">
    <header class="section__header">
      <h1 id="CollectionTitle">{{ collection.title }}</h1>
      {% if collection.description != blank %}
        <p>{{ collection.description }}</p>
      {% endif %}
    </header>

    <div class="collection-layout">
      <aside class="collection-filters" aria-label="Collection filters">
        {% if collection.filters != empty %}
          <form id="CollectionFiltersForm" method="get">
            {% for filter in collection.filters %}
              <details open>
                <summary>{{ filter.label }}</summary>
                <ul role="list">
                  {% for filter_value in filter.values %}
                    <li>
                      <label>
                        <input type="checkbox" name="{{ filter.param_name }}" value="{{ filter_value.value }}" {% if filter_value.active %}checked{% endif %}>
                        {{ filter_value.label }} ({{ filter_value.count }})
                      </label>
                    </li>
                  {% endfor %}
                </ul>
              </details>
            {% endfor %}
            <button type="submit" class="button button--small">Apply filters</button>
          </form>
        {% endif %}
      </aside>

      <div class="product-grid">
        {% for product in collection.products %}
          <article class="product-card">
            <a href="{{ product.url }}" class="product-card__image">
              {{ product.featured_image | image_url: width: 520 | image_tag: alt: product.title, loading: 'lazy' }}
            </a>
            <div class="product-card__body">
              <h2><a href="{{ product.url }}">{{ product.title }}</a></h2>
              <p class="price">{{ product.price | money }}</p>
              <div class="product-card__actions">
                <form method="post" action="/cart/add">
                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                  <button class="button button--small" type="submit">Add to cart</button>
                </form>
                <button type="button" class="button button--ghost button--small" data-quick-view-handle="{{ product.handle }}">Quick view</button>
              </div>
            </div>
          </article>
        {% else %}
          <p>No results found.</p>
        {% endfor %}
      </div>
    </div>
  </section>
{% endpaginate %}
