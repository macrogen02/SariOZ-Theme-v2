<section class="section section--muted" aria-labelledby="WeeklySpecialsTitle">
  <div class="container">
    <div class="section__header">
      <h2 id="WeeklySpecialsTitle">{{ section.settings.heading }}</h2>
      <a href="{{ section.settings.collection.url }}">View all specials</a>
    </div>

    <div class="product-grid">
      {% for product in section.settings.collection.products limit: section.settings.products_to_show %}
        {% render 'product-card', product: product %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Weekly specials",
  "settings": [
    {"type": "text", "id": "heading", "default": "Weekly specials", "label": "Heading"},
    {"type": "collection", "id": "collection", "label": "Collection"},
    {"type": "range", "id": "products_to_show", "min": 4, "max": 12, "step": 1, "default": 4, "label": "Products to show"}
  ],
  "presets": [{"name": "Weekly specials"}]
}
{% endschema %}
