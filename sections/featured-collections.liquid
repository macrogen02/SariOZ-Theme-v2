<section class="section container" aria-labelledby="FeaturedCollectionsTitle">
  <div class="section__header">
    <h2 id="FeaturedCollectionsTitle">{{ section.settings.heading }}</h2>
  </div>
  <div class="collection-grid">
    {% for block in section.blocks %}
      {% assign collection = block.settings.collection %}
      <a class="collection-tile" href="{{ collection.url }}" {{ block.shopify_attributes }}>
        {% if collection.featured_image %}
          {{ collection.featured_image | image_url: width: 700 | image_tag: alt: collection.title, loading: 'lazy' }}
        {% endif %}
        <div class="collection-tile__body">
          <h3>{{ collection.title }}</h3>
          <span>Shop now →</span>
        </div>
      </a>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Featured collections",
  "settings": [{"type": "text", "id": "heading", "label": "Heading", "default": "Popular categories"}],
  "blocks": [
    {"type": "collection", "name": "Collection", "settings": [{"type": "collection", "id": "collection", "label": "Collection"}]}
  ],
  "max_blocks": 8,
  "presets": [{"name": "Featured collections"}]
}
{% endschema %}
